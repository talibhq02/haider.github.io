+// Copyright (C) 2017-2024 Smart code 203358507
+
+@import (reference) '~stremio/common/screen-sizes.less';
+
+.hero-container {
+    position: relative;
+    z-index: 0;
+    display: flex;
+    flex-direction: row;
+    align-items: flex-end;
+    height: clamp(26rem, 72vh, 54rem);
+    margin: 0 -1rem 0.5rem;
+    touch-action: pan-y;
+
+    .backdrop {
+        position: absolute;
+        top: 0;
+        right: 0;
+        bottom: 0;
+        left: 0;
+        z-index: 0;
+        width: 100%;
+        height: 100%;
+        object-fit: cover;
+        object-position: center 20%;
+        opacity: 0;
+        transform: scale(1.06);
+        transition: opacity 1.2s ease, transform 9s linear;
+
+        &.active {
+            opacity: 1;
+            transform: scale(1);
+        }
+    }
+
+    .shade {
+        position: absolute;
+        top: 0;
+        right: 0;
+        bottom: 0;
+        left: 0;
+        z-index: 1;
+        background:
+            linear-gradient(to top, var(--primary-background-color) 0%, rgba(0, 0, 0, 0.5) 32%, rgba(0, 0, 0, 0) 60%),
+            linear-gradient(to right, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 55%),
+            linear-gradient(to bottom, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 22%);
+    }
+
+    .info {
+        position: relative;
+        z-index: 2;
+        max-width: 38rem;
+        padding: 0 3.5rem 3.5rem;
+        animation: hero-fade-in 0.8s ease both;
+
+        .logo {
+            display: block;
+            max-width: 26rem;
+            max-height: 9rem;
+            margin-bottom: 1.25rem;
+            object-fit: contain;
+            object-position: left bottom;
+            filter: drop-shadow(0 0.25rem 1.25rem rgba(0, 0, 0, 0.5));
+        }
+
+        .title {
+            margin-bottom: 1rem;
+            font-size: 3.25rem;
+            font-weight: 800;
+            line-height: 1.05;
+            letter-spacing: -0.03em;
+        }
+
+        .meta {
+            margin-bottom: 0.75rem;
+            font-size: 0.9rem;
+            font-weight: 600;
+            text-transform: capitalize;
+            opacity: 0.7;
+        }
+
+        .description {
+            display: -webkit-box;
+            -webkit-line-clamp: 3;
+            -webkit-box-orient: vertical;
+            margin-bottom: 1.5rem;
+            font-size: 1rem;
+            line-height: 1.45;
+            opacity: 0.8;
+        }
+
+        .watch-button {
+            display: inline-flex;
+            flex-direction: row;
+            align-items: center;
+            gap: 0.6rem;
+            height: 3rem;
+            padding: 0 1.9rem;
+            border-radius: 3rem;
+            background-color: rgba(255, 255, 255, 0.95);
+            transition: transform 200ms ease-out, background-color 200ms ease-out;
+
+            .icon {
+                flex: none;
+                width: 1.2rem;
+                height: 1.2rem;
+                color: #000000;
+            }
+
+            .label {
+                flex: none;
+                font-weight: 700;
+                color: #000000;
+            }
+
+            &:hover, &:focus {
+                outline: none;
+                background-color: #ffffff;
+                transform: scale(1.05);
+            }
+        }
+    }
+
+    .arrow {
+        position: absolute;
+        top: 50%;
+        z-index: 2;
+        display: flex;
+        align-items: center;
+        justify-content: center;
+        width: 3rem;
+        height: 3rem;
+        margin-top: -1.5rem;
+        border-radius: 50%;
+        border: 1px solid var(--glass-border);
+        background-color: var(--glass-background);
+        backdrop-filter: var(--glass-blur);
+        -webkit-backdrop-filter: var(--glass-blur);
+        opacity: 0;
+        pointer-events: none;
+        cursor: pointer;
+        transition: opacity 200ms ease-out, transform 200ms ease-out;
+
+        .icon {
+            width: 1.4rem;
+            height: 1.4rem;
+            color: var(--primary-foreground-color);
+        }
+
+        &:hover {
+            transform: scale(1.08);
+        }
+
+        &.prev {
+            left: 1.5rem;
+        }
+
+        &.next {
+            right: 1.5rem;
+        }
+    }
+
+    // Arrows only for mouse users; phones swipe instead
+    @media (pointer: fine) {
+        &:hover {
+            .arrow {
+                opacity: 1;
+                pointer-events: auto;
+            }
+        }
+    }
+
+    .dots {
+        position: absolute;
+        right: 3.5rem;
+        bottom: 3.75rem;
+        z-index: 2;
+        display: flex;
+        flex-direction: row;
+        gap: 0.5rem;
+
+        .dot {
+            width: 0.5rem;
+            height: 0.5rem;
+            border-radius: 1rem;
+            background-color: rgba(255, 255, 255, 0.35);
+            cursor: pointer;
+            transition: width 300ms ease, background-color 300ms ease;
+
+            &.active {
+                width: 1.5rem;
+                background-color: rgba(255, 255, 255, 0.95);
+            }
+        }
+    }
+}
+
+@keyframes hero-fade-in {
+    from {
+        opacity: 0;
+        transform: translateY(1rem);
+    }
+
+    to {
+        opacity: 1;
+        transform: none;
+    }
+}
+
+@media only screen and (max-width: @minimum) {
+    .hero-container {
+        height: 30rem;
+        margin: 0 -1rem 0;
+
+        .info {
+            max-width: 100%;
+            padding: 0 1.25rem 2rem;
+
+            .logo {
+                max-width: 70%;
+                max-height: 6rem;
+            }
+
+            .title {
+                font-size: 2.25rem;
+            }
+
+            .description {
+                -webkit-line-clamp: 2;
+                font-size: 0.9rem;
+            }
+        }
+
+        .dots {
+            display: none;
+        }
+    }
+}
