diff --git a/src/routes/Board/Hero/Hero.js b/src/routes/Board/Hero/Hero.js
new file mode 100644
index 0000000..7e533f1
--- /dev/null
+++ b/src/routes/Board/Hero/Hero.js
@@ -0,0 +1,158 @@
+// Copyright (C) 2017-2023 Smart code 203358507
+
+const React = require('react');
+const PropTypes = require('prop-types');
+const classnames = require('classnames');
+const { default: Icon } = require('@stremio/stremio-icons/react');
+const { Button, Image } = require('stremio/components');
+const { default: getMetaDetailsHref } = require('stremio/common/getMetaDetailsHref');
+const styles = require('./styles');
+
+const MAX_ITEMS = 6;
+const ROTATE_INTERVAL = 8000;
+const SWIPE_THRESHOLD = 50;
+
+const metahubUrl = (kind, id) => `https://images.metahub.space/${kind}/large/${id}/img`;
+
+// Feature titles from the first loaded catalog that has IMDb items (they have artwork)
+const pickItems = (catalogs) => {
+    for (const catalog of catalogs) {
+        if (catalog.content?.type === 'Ready' && Array.isArray(catalog.content.content)) {
+            const items = catalog.content.content.filter((item) => typeof item.id === 'string' && item.id.startsWith('tt'));
+            if (items.length > 0) {
+                return items.slice(0, MAX_ITEMS);
+            }
+        }
+    }
+
+    return [];
+};
+
+const Hero = ({ className, catalogs }) => {
+    const items = React.useMemo(() => pickItems(catalogs), [catalogs]);
+    const [index, setIndex] = React.useState(0);
+    const selectedIndex = items.length > 0 ? index % items.length : 0;
+    const item = items[selectedIndex];
+
+    React.useEffect(() => {
+        if (items.length < 2) {
+            return;
+        }
+
+        const timeout = setTimeout(() => setIndex((selectedIndex + 1) % items.length), ROTATE_INTERVAL);
+        return () => clearTimeout(timeout);
+    }, [items.length, selectedIndex]);
+
+    const goTo = React.useCallback((nextIndex) => {
+        if (items.length > 0) {
+            setIndex((nextIndex + items.length) % items.length);
+        }
+    }, [items.length]);
+
+    // Horizontal swipes switch titles; vertical ones still scroll the board
+    const touchStartRef = React.useRef(null);
+    const onTouchStart = React.useCallback((event) => {
+        const touch = event.touches[0];
+        touchStartRef.current = { x: touch.clientX, y: touch.clientY };
+    }, []);
+    const onTouchEnd = React.useCallback((event) => {
+        if (touchStartRef.current === null) {
+            return;
+        }
+
+        const touch = event.changedTouches[0];
+        const deltaX = touch.clientX - touchStartRef.current.x;
+        const deltaY = touch.clientY - touchStartRef.current.y;
+        touchStartRef.current = null;
+        if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
+            goTo(selectedIndex + (deltaX < 0 ? 1 : -1));
+        }
+    }, [goTo, selectedIndex]);
+
+    const renderTitle = React.useCallback(() => (
+        <div className={styles['title']}>{item ? item.name : ''}</div>
+    ), [item]);
+
+    // Always render an element so the board's row index offsets stay stable
+    if (!item) {
+        return <div className={className} />;
+    }
+
+    const href = getMetaDetailsHref(item.deepLinks);
+    const meta = [item.type === 'series' ? 'Series' : item.type === 'movie' ? 'Movie' : item.type, item.releaseInfo]
+        .filter((value) => typeof value === 'string' && value.length > 0)
+        .join('  ·  ');
+
+    return (
+        <div className={classnames(className, styles['hero-container'])} onTouchStart={onTouchStart} onTouchEnd={onTouchEnd}>
+            {items.map((heroItem, heroIndex) => (
+                <Image
+                    key={heroItem.id}
+                    className={classnames(styles['backdrop'], { [styles['active']]: heroIndex === selectedIndex })}
+                    src={typeof heroItem.background === 'string' ? heroItem.background : metahubUrl('background', heroItem.id)}
+                    fallbackSrc={typeof heroItem.poster === 'string' ? heroItem.poster : undefined}
+                    alt={' '}
+                />
+            ))}
+            <div className={styles['shade']} />
+            <div key={item.id} className={styles['info']}>
+                <Image
+                    className={styles['logo']}
+                    src={typeof item.logo === 'string' ? item.logo : metahubUrl('logo', item.id)}
+                    alt={item.name}
+                    renderFallback={renderTitle}
+                />
+                {meta.length > 0 ? <div className={styles['meta']}>{meta}</div> : null}
+                {
+                    typeof item.description === 'string' && item.description.length > 0 ?
+                        <div className={styles['description']}>{item.description}</div>
+                        :
+                        null
+                }
+                {
+                    typeof href === 'string' ?
+                        <Button className={styles['watch-button']} href={href} tabIndex={-1}>
+                            <Icon className={styles['icon']} name={'play'} />
+                            <div className={styles['label']}>Watch</div>
+                        </Button>
+                        :
+                        null
+                }
+            </div>
+            {
+                items.length > 1 ?
+                    <React.Fragment>
+                        <div className={classnames(styles['arrow'], styles['prev'])} onClick={() => goTo(selectedIndex - 1)}>
+                            <Icon className={styles['icon']} name={'chevron-back'} />
+                        </div>
+                        <div className={classnames(styles['arrow'], styles['next'])} onClick={() => goTo(selectedIndex + 1)}>
+                            <Icon className={styles['icon']} name={'chevron-forward'} />
+                        </div>
+                    </React.Fragment>
+                    :
+                    null
+            }
+            {
+                items.length > 1 ?
+                    <div className={styles['dots']}>
+                        {items.map((heroItem, heroIndex) => (
+                            <div
+                                key={heroItem.id}
+                                className={classnames(styles['dot'], { [styles['active']]: heroIndex === selectedIndex })}
+                                onClick={() => goTo(heroIndex)}
+                            />
+                        ))}
+                    </div>
+                    :
+                    null
+            }
+        </div>
+    );
+};
+
+Hero.propTypes = {
+    className: PropTypes.string,
+    catalogs: PropTypes.arrayOf(PropTypes.object).isRequired,
+};
+
+module.exports = Hero;
